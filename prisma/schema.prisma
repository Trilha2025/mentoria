generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String?
  businessData   Json?
  role           Role                 @default(MENTEE)
  accessType     AccessType           @default(COMMUNITY)
  lastAccess     DateTime             @updatedAt
  createdAt      DateTime             @default(now())
  mentorId       String?
  employerId     String?
  avatarUrl      String?
  submissions    DocumentSubmission[]
  lessonProgress LessonProgress[]
  notifications  Notification[]
  studyPlanItems StudyPlanItem[]
  supportTickets SupportTicket[]
  sentMessages   TicketMessage[]
  mentor         User?                @relation("Mentorship", fields: [mentorId], references: [id])
  mentees        User[]               @relation("Mentorship")
  employer       User?                @relation("Enterprise", fields: [employerId], references: [id])
  employees      User[]               @relation("Enterprise")
  badges         UserBadge[]
  modulesAccess  UserModuleAccess[]
  lessonsAccess  UserLessonAccess[]
  lessonNotes    LessonNote[]
  plannerItems   PlannerItem[]
  
  // Community Relations
  posts          Post[]
  comments       Comment[]
  likes          Like[]
  
  communityMember CommunityMember?
  platformConnections PlatformConnection[]
}

model PlatformConnection {
  id             String   @id @default(cuid())
  userId         String
  platform       String   // "MERCADOLIVRE" or "SHOPEE"
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  expiresAt      DateTime
  externalUserId String?  // ML User ID or Shopee Shop ID
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String
  subject   String?
  status    TicketStatus    @default(OPEN)
  category  TicketCategory  @default(TECHNICAL)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  messages  TicketMessage[]
}

model TicketMessage {
  id            String        @id @default(cuid())
  ticketId      String
  senderId      String
  content       String
  attachmentUrl String?
  read          Boolean       @default(false)
  createdAt     DateTime      @default(now())
  sender        User          @relation(fields: [senderId], references: [id])
  ticket        SupportTicket @relation(fields: [ticketId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("INFO")
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Module {
  id             String               @id @default(cuid())
  title          String
  description    String?
  order          Int
  submissions    DocumentSubmission[]
  lessons        Lesson[]
  studyPlanItems StudyPlanItem[]
  accessBy       UserModuleAccess[]
}

model Lesson {
  id             String           @id @default(cuid())
  moduleId       String
  title          String
  content        String?
  videoUrl       String?
  tasks          String?
  materialUrl    String?
  module         Module           @relation(fields: [moduleId], references: [id])
  progress       LessonProgress[]
  studyPlanItems StudyPlanItem[]
  accessBy       UserLessonAccess[]
  submissions    DocumentSubmission[]
  lessonNotes    LessonNote[]
  plannerItems   PlannerItem[]
}

model UserModuleAccess {
  id       String       @id @default(cuid())
  userId   String
  moduleId String
  status   AccessStatus @default(LOCKED)
  module   Module       @relation(fields: [moduleId], references: [id])
  user     User         @relation(fields: [userId], references: [id])

  @@unique([userId, moduleId])
}

model UserLessonAccess {
  id       String       @id @default(cuid())
  userId   String
  lessonId String
  status   AccessStatus @default(LOCKED)
  lesson   Lesson       @relation(fields: [lessonId], references: [id])
  user     User         @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
}

model DocumentSubmission {
  id             String    @id @default(cuid())
  userId         String
  moduleId       String
  lessonId       String?
  fileUrl        String
  status         String    @default("PENDING")
  mentorFeedback String?
  createdAt      DateTime  @default(now())
  evaluatedAt    DateTime?
  feedback       String?
  updatedAt      DateTime  @default(now()) @updatedAt
  Module         Module    @relation(fields: [moduleId], references: [id])
  lesson         Lesson?   @relation(fields: [lessonId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
}

model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  icon        String
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model StudyPlanItem {
  id       String   @id @default(cuid())
  userId   String
  lessonId String
  moduleId String
  addedAt  DateTime @default(now())
  order    Int      @default(0)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, moduleId])
}

enum Role {
  MENTOR
  MENTEE
  ADMIN
  SUPPORT
}

enum AccessType {
  COMMUNITY
  CONSULTING
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  TECHNICAL
  MENTORSHIP
}

enum AccessStatus {
  LOCKED
  UNLOCKED
  COMPLETED
}

model PlannerItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  type        String   @default("STUDY") // STUDY, PERSONAL, WORK, MEETING, LIVE
  completed   Boolean  @default(false)
  lessonId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson?  @relation(fields: [lessonId], references: [id])

  @@index([userId, startTime])
}

// --- COMMUNITY ACCESS CONTROL ---

enum CommunityRole {
  MEMBER
  MODERATOR
  ADMIN
}

model CommunityMember {
  id        String        @id @default(cuid())
  userId    String        @unique
  role      CommunityRole @default(MEMBER)
  
  joinedAt  DateTime      @default(now())
  banned    Boolean       @default(false)
  
  // Profile fields specific to community
  bio       String?
  headline  String?
  
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// --- COMMUNITY MODULE ---

enum SpaceType {
  POST
  CHAT
  EVENT
  COURSE
  LINK
// ... existing ...

}

enum SpaceViewStyle {
  LIST
  CARD
  GRID
}

model SpaceGroup {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  emoji       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spaces      Space[]
}

model Space {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  emoji       String?
  coverUrl    String?
  
  type        SpaceType      @default(POST)
  viewStyle   SpaceViewStyle @default(LIST)
  
  isPrivate   Boolean        @default(false)
  order       Int            @default(0)
  
  externalLink String?       // URL for LINK type spaces
  
  groupId     String
  group       SpaceGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  posts       Post[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  isPinned    Boolean  @default(false)
  
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  comments    Comment[]
  likes       Like[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  parentId    String?
  parent      Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}
